#!/usr/bin/env python3
"""
AI-Driven Planner for ALICE.

Replaces the pattern-based TaskPlanner with an LLM-driven planning system.
Uses structured tool schemas to generate plans through the language model.
"""

from __future__ import annotations

import json
import logging
import uuid
from dataclasses import dataclass, field
from datetime import datetime
from typing import Any, Dict, List, Optional, Callable

logger = logging.getLogger(__name__)


@dataclass
class PlanStep:
    """A single step in a task plan."""
    step_id: str = field(default_factory=lambda: str(uuid.uuid4()))
    tool_name: str = ""
    parameters: Dict[str, Any] = field(default_factory=dict)
    expected_outcome: str = ""
    verification_criteria: str = ""
    dependencies: List[str] = field(default_factory=list)
    thought: str = ""

    def to_dict(self) -> Dict[str, Any]:
        return {
            "step_id": self.step_id,
            "tool_name": self.tool_name,
            "parameters": self.parameters,
            "expected_outcome": self.expected_outcome,
            "verification_criteria": self.verification_criteria,
            "dependencies": self.dependencies,
            "thought": self.thought,
        }

    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> "PlanStep":
        return cls(
            step_id=data.get("step_id", str(uuid.uuid4())),
            tool_name=data.get("tool_name", ""),
            parameters=data.get("parameters", {}),
            expected_outcome=data.get("expected_outcome", ""),
            verification_criteria=data.get("verification_criteria", ""),
            dependencies=data.get("dependencies", []),
            thought=data.get("thought", ""),
        )


@dataclass
class GeneratedPlan:
    """A complete task plan generated by the AI."""
    plan_id: str = field(default_factory=lambda: str(uuid.uuid4()))
    intent: str = ""
    steps: List[PlanStep] = field(default_factory=list)
    original_query: str = ""
    generated_at: str = field(default_factory=lambda: datetime.utcnow().isoformat())
    confidence: float = 0.0
    notes: str = ""

    def to_dict(self) -> Dict[str, Any]:
        return {
            "plan_id": self.plan_id,
            "intent": self.intent,
            "steps": [s.to_dict() for s in self.steps],
            "original_query": self.original_query,
            "generated_at": self.generated_at,
            "confidence": self.confidence,
            "notes": self.notes,
        }

    @classmethod
    def from_dict(cls, data: Dict[str, Any]) -> "GeneratedPlan":
        steps = [PlanStep.from_dict(s) for s in data.get("steps", [])]
        return cls(
            plan_id=data.get("plan_id", str(uuid.uuid4())),
            intent=data.get("intent", ""),
            steps=steps,
            original_query=data.get("original_query", ""),
            generated_at=data.get("generated_at", datetime.utcnow().isoformat()),
            confidence=data.get("confidence", 0.0),
            notes=data.get("notes", ""),
        )


class AIPlanner:
    """
    AI-driven task planner that generates plans using language model tool calling.

    This planner uses the LLM with structured tool schemas to generate plans.
    It replaces the pattern-based TaskPlanner as the primary planning mechanism.
    """

    # System prompt for planning - compact but comprehensive
    PLANNING_SYSTEM_PROMPT = '''You are ALICE, a Windows desktop assistant. Generate a step-by-step plan
for completing the user's request using available tools. Each step must have:
- tool_name: exact tool name from schema
- parameters: dict matching the tool's required parameters
- expected_outcome: what should happen when this step succeeds
- verification_criteria: how to verify the step completed successfully
- thought: brief reasoning for this step

Execute steps sequentially. Only use tools provided in the schema.
If a request cannot be fulfilled, explain why in your response.

Current system context:
- Windows desktop environment
- User wants tasks completed safely and efficiently
- All paths will be validated
- Actions are sequential (one at a time)

Available tools and their schemas:'''

    def __init__(
        self,
        tool_registry: Optional[Dict[str, Callable]] = None,
        model_adapter: Optional[Any] = None,
        context_manager: Optional[Any] = None,
    ):
        """
        Initialize the AI Planner.

        Args:
            tool_registry: Dictionary mapping tool names to their schema/callables
            model_adapter: The LMStudioAdapter or compatible model interface
            context_manager: Context manager for token budget tracking
        """
        self.tool_registry = tool_registry or {}
        self.model_adapter = model_adapter
        self.context_manager = context_manager
        self._tool_schemas: Dict[str, Dict[str, Any]] = {}
        self._build_tool_schemas()

    def _get_tool_registry_items(self) -> Dict[str, Any]:
        """Extract tool items from tool_registry, handling both dict and ToolRegistry interfaces.

        Returns a dict mapping tool_name -> tool_def, working with:
        - Plain dict: .items() directly
        - ToolRegistry: .tools dict attribute
        """
        if isinstance(self.tool_registry, dict):
            return self.tool_registry
        elif hasattr(self.tool_registry, 'tools'):
            return self.tool_registry.tools
        else:
            # Fall back to .items() if available
            try:
                return dict(self.tool_registry.items())
            except (AttributeError, TypeError):
                return {}

def _build_tool_schemas(self) -> None:
        """Build JSON schemas for all available tools."""
        if not self.tool_registry:
            logger.warning("No tool registry provided to AIPlanner")
            return

        tool_items = self._get_tool_registry_items()
        if not tool_items:
            logger.warning("No tools found in tool registry")
            return

        for tool_name, tool_def in tool_items.items():
            if hasattr(tool_def, "schema"):
                self._tool_schemas[tool_name] = tool_def.schema
            elif isinstance(tool_def, dict) and "schema" in tool_def:
                self._tool_schemas[tool_name] = tool_def["schema"]
            elif callable(tool_def) and hasattr(tool_def, "__doc__"):
                # Build a minimal schema for callable
                self._tool_schemas[tool_name] = self._infer_schema(tool_def, tool_name)

    def _infer_schema(self, func: Callable, tool_name: str) -> Dict[str, Any]:
        """Infer a tool schema from a callable's signature."""
        import inspect
        try:
            sig = inspect.signature(func)
            properties = {}
            required = []

            for param_name, param in sig.parameters.items():
                if param_name == "self":
                    continue
                prop = {}
                if param.annotation != inspect.Parameter.empty:
                    annotation = param.annotation
                    if hasattr(annotation, "__name__"):
                        types_map = {
                            str: "string",
                            int: "integer",
                            float: "number",
                            bool: "boolean",
                            list: "array",
                            dict: "object",
                        }
                        prop["type"] = types_map.get(types_map.get(annotation.__name__, "string"), "string")
                    else:
                        prop["type"] = "string"
                else:
                    prop["type"] = "string"

                if param.default != inspect.Parameter.empty and param.default is not None:
                    prop["default"] = param.default
                elif param.default == inspect.Parameter.empty:
                    required.append(param_name)

                properties[param_name] = prop

            return {
                "type": "object",
                "properties": properties,
                "required": required,
                "additionalProperties": False,
            }
        except Exception as e:
            logger.debug(f"Could not infer schema for {tool_name}: {e}")
            return {"type": "object", "properties": {}, "required": []}

    def _get_tools_schema_string(self) -> str:
        """Generate a JSON string of all tool schemas for the system prompt."""
        if not self._tool_schemas:
            return "{}"

        # Compact representation for token efficiency
        compact = {}
        for name, schema in self._tool_schemas.items():
            props = schema.get("properties", {})
            # Keep only essential info
            compact[name] = {
                "type": "function",
                "parameters": {
                    "type": "object",
                    "properties": props,
                    "required": schema.get("required", []),
                }
            }
        return json.dumps(compact, separators=(",", ":"))

    def _format_verification_criteria(
        self,
        tool_name: str,
        parameters: Dict[str, Any]
    ) -> tuple[str, str]:
        """Generate expected outcome and verification criteria for a tool call."""
        # Standard templates for common tools
        templates = {
            "open_app": (
                "Application should launch and be running",
                "Check if process exists or window appears within 3 seconds"
            ),
            "read_file": (
                "File contents should be returned as text",
                "Verify returned content is non-empty for files that exist"
            ),
            "write_file": (
                f"File {parameters.get('path', 'file')} should be created/updated",
                "Verify file exists at specified path after operation"
            ),
            "create_folder": (
                f"Folder {parameters.get('path', 'folder')} should be created",
                "Verify folder exists at specified path"
            ),
            "delete_file": (
                f"File {parameters.get('path', 'file')} should be deleted",
                "Verify file no longer exists at path"
            ),
            "move_file": (
                f"File should be moved from {parameters.get('src')} to {parameters.get('dst')}",
                "Verify source no longer exists and destination exists with correct content"
            ),
            "copy_file": (
                f"File should be copied from {parameters.get('src')} to {parameters.get('dst')}",
                "Verify both source and destination exist with identical content"
            ),
            "search_files": (
                "Search should return matching files within allowed locations",
                "Return non-empty list if matches exist, empty list if none"
            ),
            "list_installed_apps": (
                "Should return list of installed applications",
                "Return list with name, path, and type for each app"
            ),
            "type_text": (
                "Specified text should be typed into the active window",
                "Text appears in the target application after typing"
            ),
            "keyboard_shortcut": (
                f"Keyboard shortcut {parameters.get('keys', '')} should execute",
                "Verify action completed via visual/UIA inspection"
            ),
            "mouse_click": (
                "Mouse should click at specified coordinates",
                "Click action should result in UI state change"
            ),
            "mouse_move": (
                "Mouse should move to specified coordinates",
                "Mouse cursor position should match coordinates"
            ),
            "focus_app": (
                f"Focus should be set to {parameters.get('app_name', 'application')}",
                "Application window should be active and in foreground"
            ),
            "close_app": (
                f"Application {parameters.get('app_name', 'app')} should close",
                "Process should no longer be running"
            ),
            "open_browser": (
                f"Browser should open to {parameters.get('url', 'default page')}",
                "Browser window should appear with specified URL"
            ),
        }

        if tool_name in templates:
            return templates[tool_name]

        # Generic template for unknown tools
        return f"Tool {tool_name} should execute successfully", f"Verify tool completed without error"

    def plan(self, query: str) -> List[PlanStep]:
        """
        Generate a plan for the given user query.

        This is the main entry point - replaces TaskPlanner.plan()

        Args:
            query: The user's natural language request

        Returns:
            List of PlanStep objects to execute sequentially
        """
        if not self.model_adapter:
            logger.warning("No model adapter available, returning empty plan")
            return []

        # Get the tools schema string
        tools_schema = self._get_tools_schema_string()

        # Build the system prompt
        system_prompt = self.PLANNING_SYSTEM_PROMPT + "\n" + tools_schema

        user_prompt = f"User request: {query}\n\nGenerate a plan to fulfill this request."

        try:
            # Use the model adapter to generate a plan
            result = self.model_adapter.generate_plan(
                system_prompt=system_prompt,
                user_prompt=user_prompt,
                tools_schema=self._tool_schemas,
            )

            if result:
                return self._parse_plan_result(result)

        except Exception as e:
            logger.error(f"AI planning failed: {e}")
            # Fall back to empty plan to signal we couldn't generate one

        return []

    def _parse_plan_result(self, result: Any) -> List[PlanStep]:
        """Parse the model's plan result into PlanStep objects."""
        steps = []

        # Handle different result formats
        if isinstance(result, dict):
            if "steps" in result:
                for step_data in result["steps"]:
                    if isinstance(step_data, dict):
                        step = PlanStep.from_dict(step_data)
                        if step.tool_name:
                            steps.append(step)
            elif "plan" in result and isinstance(result["plan"], dict):
                plan_data = result["plan"]
                if "steps" in plan_data:
                    for step_data in plan_data["steps"]:
                        if isinstance(step_data, dict):
                            step = PlanStep.from_dict(step_data)
                            if step.tool_name:
                                steps.append(step)
        elif isinstance(result, str):
            # Try to parse JSON plan from string
            try:
                parsed = json.loads(result)
                for step_data in parsed.get("steps", parsed):
                    if isinstance(step_data, dict):
                        step = PlanStep.from_dict(step_data)
                        if step.tool_name:
                            steps.append(step)
            except json.JSONDecodeError:
                logger.debug(f"Could not parse plan string: {result[:200] if len(result) > 200 else result}")

        # Validate steps
        valid_steps = []
        for step in steps:
            if step.tool_name in self.tool_registry or not self.tool_registry:
                valid_steps.append(step)
            else:
                logger.warning(f"Unknown tool '{step.tool_name}' in plan, skipping")

        return valid_steps

    def refine_plan(
        self,
        plan: List[PlanStep],
        context: str,
        model_adapter: Any
    ) -> List[PlanStep]:
        """Refine an existing plan with additional context."""
        if not plan:
            return plan

        # For now, return as-is - refinement logic goes here
        # Could be used to adjust plan based on system state
        return plan

    def validate_plan(self, plan: List[PlanStep]) -> bool:
        """Check if a plan is valid and executable."""
        if not plan:
            return False

        for step in plan:
            if not step.tool_name:
                return False
            if not self._tool_schemas and not self.tool_registry:
                return False
            if step.tool_name not in self._tool_schemas and step.tool_name not in self.tool_registry:
                return False

        return True


def create_ai_planner_from_app(app: "AliceApplication") -> AIPlanner:
    """Factory function to create an AIPlanner from an AliceApplication instance."""
    return AIPlanner(
        tool_registry=getattr(app, "tool_registry", {}),
        model_adapter=getattr(app, "model_adapter", None),
        context_manager=getattr(app, "context_manager", None),
    )